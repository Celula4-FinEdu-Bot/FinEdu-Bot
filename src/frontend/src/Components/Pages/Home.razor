@page "/"
@rendermode InteractiveServer

@using src.Models
@using src.Services
@using System.Reflection
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

@inject NlqService NlqService

<PageTitle>FinEdu-Bot - Monitor de Transparencia</PageTitle>

<div class="page-container">

    <!-- ENCABEZADO -->
    <div class="page-header">
        <div>
            <span class="eyebrow">FINEDU-BOT</span>

            <h1>
                Monitor de Transparencia
                <br />
                Económica y Gasto Público
            </h1>

            <p class="subtitle">
                Consulta información presupuestaria del MEF utilizando lenguaje natural.
            </p>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="query-card">

        <!-- CABECERA -->
        <div class="query-header">

            <div>
                <span class="section-label">
                    NATURAL LANGUAGE QUERY
                </span>

                <h2>
                    ¿Qué deseas consultar?
                </h2>
            </div>

            <div class="source-badge">
                MEF
            </div>

        </div>

        <!-- FORMULARIO -->
        <div class="query-form">

            <input
                class="query-input"
                type="text"
                @bind="Pregunta"
                @bind:event="oninput"
                @onkeydown="HandleKeyDown"
                placeholder="Ej. ¿Cuál fue la evolución del presupuesto entre 2022 y 2026?"
                />

            <button
                type="button"
                class="query-button"
                @onclick="ConsultarAsync"
                >

                @if (Cargando)
                {
                    <span class="spinner"></span>
                    <span>Consultando...</span>
                }
                else
                {
                    <span>Consultar</span>
                }

            </button>
            <button type="button" @onclick="ProbarBoton">
                PROBAR BLAZOR
            </button>

            <p>Contador: @contador</p>

        </div>

        <!-- EJEMPLOS -->
        <div class="examples">

            <span class="examples-title">
                Ejemplos:
            </span>

            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("¿Cuál fue la evolución del presupuesto entre 2022 y 2026?")'>

                Evolución 2022-2026

            </button>

            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("¿Cuál fue el presupuesto de la Municipalidad de Lima entre 2022 y 2026?")'>

                Municipalidad de Lima

            </button>

            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("¿Cuál fue el presupuesto del Gobierno Regional entre 2022 y 2026?")'>

                Gobierno Regional

            </button>

        </div>

        <!-- RESULTADO -->
        @if (Resultado != null)
        {
            <!-- RESUMEN -->
            <div class="summary-grid">

                <!-- INTENCIÓN -->
                <div class="summary-card">

                    <span class="summary-label">
                        INTENCIÓN DETECTADA
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Resultado.Intent)
                            ? "No identificada"
                            : Resultado.Intent)
                    </strong>

                </div>

                <!-- ESTADO -->
                <div class="summary-card">

                    <span class="summary-label">
                        ESTADO
                    </span>

                    <strong class="@(Resultado.Success ? "success" : "error")">

                        @(Resultado.Success
                            ? "ÉXITO"
                            : "SIN DATOS")

                    </strong>

                </div>

                <!-- FUENTE -->
                <div class="summary-card">

                    <span class="summary-label">
                        FUENTE
                    </span>

                    <strong class="source-text">
                        MEF
                    </strong>

                </div>

            </div>

            <!-- MENSAJE -->
            @if (!string.IsNullOrWhiteSpace(Resultado.Message))
            {
                <div class="message-box @(Resultado.Success ? "message-success" : "message-warning")">

                    @Resultado.Message

                </div>
            }

            <!-- RESULTADOS -->
            @if (Resultado.Evolucion != null &&
                 Resultado.Evolucion.Any())
            {
                <div class="results-container">

                    <!-- CABECERA RESULTADOS -->
                    <div class="results-header">

                        <div>

                            <span class="section-label">
                                RESULTADOS MEF
                            </span>

                            <h3>
                                Evolución presupuestaria 2022-2026
                            </h3>

                        </div>

                        <span class="result-count">
                            @Resultado.Evolucion.Count registro(s)
                        </span>

                    </div>

                    <!-- TABLA -->
                    <div class="table-wrapper">

                        <table class="results-table">

    <thead>
        <tr>
            <th>AÑO</th>
            <th>ENTIDAD</th>
            <th>PIA</th>
            <th>PIM</th>
            <th>DEVENGADO</th>
            <th>% EJECUCIÓN</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var registro in Resultado.Evolucion)
        {
            <tr>

                <td>
                    @registro.Anio
                </td>

                <td class="entity-cell">
                    @(string.IsNullOrWhiteSpace(registro.Entidad)
                        ? "-"
                        : registro.Entidad)
                </td>

                <td>
                    S/
                    @registro.PresupuestoInicial.ToString(
                        "N2",
                        new CultureInfo("es-PE"))
                </td>

                <td>
                    S/
                    @registro.PresupuestoModificado.ToString(
                        "N2",
                        new CultureInfo("es-PE"))
                </td>

                <td>
                    S/
                    @registro.MontoEjecutado.ToString(
                        "N2",
                        new CultureInfo("es-PE"))
                </td>

                <td>
                    @registro.PorcentajeEjecucion.ToString(
                        "N2",
                        new CultureInfo("es-PE"))%
                </td>

            </tr>
        }

    </tbody>

</table>

                    </div>

                </div>
            }
            else if (!Cargando && ConsultaRealizada)
            {
                <!-- SIN DATOS -->

                <div class="no-results">

                    <div class="no-results-icon">
                        !
                    </div>

                    <div>

                        <h3>
                            No se encontraron datos.
                        </h3>

                        <p>
                            El MEF no devolvió registros para la consulta realizada.
                            Verifica el nombre de la entidad o realiza una consulta
                            para el período 2022-2026.
                        </p>

                    </div>

                </div>
            }

        }

    </div>

</div>

@code {
    private int contador = 0;

    private void ProbarBoton()
    {
        contador++;
    }

    private string Pregunta =
        "¿Cuál fue la evolución del presupuesto entre 2022 y 2026?";

    private NlqResponse? Resultado;

    private bool Cargando = false;

    private bool ConsultaRealizada = false;


    private async Task ConsultarAsync()
    {
        if (Cargando)
            return;

        if (string.IsNullOrWhiteSpace(Pregunta))
            return;

        Cargando = true;
        ConsultaRealizada = false;
        Resultado = null;

        try
        {
            Resultado = await NlqService.ProcesarAsync(
                Pregunta.Trim(),
                CancellationToken.None
            );

            ConsultaRealizada = true;
        }
        catch (Exception ex)
        {
            Resultado = new NlqResponse
            {
                Success = false,
                Intent = "Error",
                Message = $"No fue posible procesar la consulta: {ex.Message}",
                Evolucion = []
            };

            ConsultaRealizada = true;
        }
        finally
        {
            Cargando = false;
        }
    }


    private async Task HandleKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConsultarAsync();
        }
    }


    private void UsarEjemplo(string texto)
    {
        Pregunta = texto;
    }


    private static string GetValue(
        object? objeto,
        params string[] nombres)
    {
        if (objeto == null)
            return "-";

        var tipo = objeto.GetType();

        foreach (var nombre in nombres)
        {
            var propiedad = tipo.GetProperty(
                nombre,
                BindingFlags.Public |
                BindingFlags.Instance |
                BindingFlags.IgnoreCase
            );

            if (propiedad == null)
                continue;

            var valor = propiedad.GetValue(objeto);

            if (valor == null)
                continue;

            var texto = valor.ToString();

            if (!string.IsNullOrWhiteSpace(texto))
                return texto;
        }

        return "-";
    }


    private static string FormatMoney(string valor)
    {
        if (string.IsNullOrWhiteSpace(valor) ||
            valor == "-")
        {
            return "-";
        }

        if (decimal.TryParse(
            valor,
            NumberStyles.Any,
            CultureInfo.InvariantCulture,
            out var numero))
        {
            return numero.ToString(
                "N2",
                new CultureInfo("es-PE")
            );
        }

        return valor;
    }

}