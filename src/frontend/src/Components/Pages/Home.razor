                                    <!-- ================================= -->
                                    <!-- 2021 -->
                                    <!-- ================================= -->

                                    <tr>

                                        <td>
                                            2021
                                        </td>

                                        <td class="entity-cell">
                                            @(registro.EjecutoraNombre
                                                ?? "Todas las entidades")
                                        </td>

                                        <td>
