                                        </td>

                                        <td>
                                            @registro.NivelGobiernoNombre
                                        </td>

                                        <td>
                                            @registro.DepartamentoEjecutoraNombre
                                        </td>

                                        <td>
                                            S/
                                            @registro.Pia2018.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Pim2018.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Devengado2018.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>

