                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Pim2017.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Devengado2017.ToString(
