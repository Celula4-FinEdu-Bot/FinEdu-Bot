@page "/"
@rendermode InteractiveServer

@using src.Models
@using src.Services
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

@inject NlqService NlqService

<PageTitle>FinEdu-Bot - Monitor de Transparencia</PageTitle>

<div class="page-container">

    <!-- ====================================================== -->
    <!-- ENCABEZADO -->
    <!-- ====================================================== -->

    <div class="page-header">

        <div>

            <span class="eyebrow">
                FINEDU-BOT
            </span>

            <h1>
                Monitor de Transparencia
                <br />
                Económica y Gasto Público
            </h1>

            <p class="subtitle">
                Consulta información presupuestaria del Ministerio de economía y Finanzas (MEF)
                utilizando lenguaje natural.
            </p>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ====================================================== -->

    <div class="query-card">

        <!-- ================================================== -->
        <!-- CABECERA -->
        <!-- ================================================== -->

        <div class="query-header">

            <div>

                <span class="section-label">
                    NATURAL LANGUAGE QUERY
                </span>

                <h2>
                    ¿Qué deseas consultar?
                </h2>

            </div>

            <div class="source-badge">
                MEF
            </div>

        </div>


        <!-- ================================================== -->
        <!-- FORMULARIO -->
        <!-- ================================================== -->

        <div class="query-form">

            <input
                class="query-input"
                type="text"
                @bind="Pregunta"
                @bind:event="oninput"
                @onkeydown="HandleKeyDown"
                placeholder="Ej. ¿Cuál fue la evolución del presupuesto entre 2017 y 2021?"
            />

            <button
                type="button"
                class="query-button"
                disabled="@Cargando"
                @onclick="ConsultarAsync">

                @if (Cargando)
                {
                    <span class="spinner"></span>

                    <span>
                        Consultando...
                    </span>
                }
                else
                {
                    <span>
                        Consultar
                    </span>
                }

            </button>

        </div>


        <!-- ================================================== -->
        <!-- EJEMPLOS -->
        <!-- ================================================== -->

        <div class="examples">

            <span class="examples-title">
                Ejemplos:
            </span>

            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("¿Cuál fue la evolución del presupuesto entre 2017 y 2021?")'>

                Evolución 2017-2021

            </button>

            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("¿Cuál fue el presupuesto de la Municipalidad Distrital de Monzon en 2021?")'>

                Municipalidad de Monzón

            </button>

            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("¿Cuánto se devengó en la Municipalidad Distrital de Cerro Azul en 2021?")'>

                Cerro Azul

            </button>

        </div>


        <!-- ================================================== -->
        <!-- RESULTADO -->
        <!-- ================================================== -->

        @if (Resultado != null)
        {

            <!-- ============================================== -->
            <!-- RESUMEN -->
            <!-- ============================================== -->

            <div class="summary-grid">

                <!-- INTENCIÓN -->

                <div class="summary-card">

                    <span class="summary-label">
                        INTENCIÓN DETECTADA
                    </span>

                    <strong>

                        @(string.IsNullOrWhiteSpace(
                            Resultado.Intent)
                            ? "No identificada"
                            : Resultado.Intent)

                    </strong>

                </div>


                <!-- ESTADO -->

                <div class="summary-card">

                    <span class="summary-label">
                        ESTADO
                    </span>

                    <strong class="@(Resultado.Success
                        ? "success"
                        : "error")">

                        @(Resultado.Success
                            ? "ÉXITO"
                            : "SIN DATOS")

                    </strong>

                </div>


                <!-- FUENTE -->

                <div class="summary-card">

                    <span class="summary-label">
                        FUENTE
                    </span>

                    <strong class="source-text">
                        MEF
                    </strong>

                </div>

            </div>


            <!-- ============================================== -->
            <!-- MENSAJE -->
            <!-- ============================================== -->

            @if (!string.IsNullOrWhiteSpace(Resultado.Message))
            {
                <div class="message-box @(Resultado.Success
                    ? "message-success"
                    : "message-warning")">

                    @Resultado.Message

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Resultado.Output))
            {
                <div class="message-box message-success">
                    @Resultado.Output
                </div>
            }


            <!-- ============================================== -->
            <!-- RESULTADOS -->
            <!-- ============================================== -->
            <!-- ============================================== -->
            <!-- RESULTADOS -->
            <!-- ============================================== -->

            <!-- ============================================== -->
            <!-- RESULTADOS -->
            <!-- ============================================== -->

            @if (Resultado?.Evolucion is { Count: > 0 })
            {
