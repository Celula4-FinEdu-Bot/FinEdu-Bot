                                                        ? (
                                                            registro.Devengado2018 /
                                                            registro.Pim2018
                                                        ) * 100
                                                        : 0m;
                                            }

                                            @porcentaje2018.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))%

                                        </td>

                                    </tr>


                                    <!-- ================================= -->
                                    <!-- 2019 -->
                                    <!-- ================================= -->

                                    <tr>

                                        <td>
                                            2019
                                        </td>

                                        <td class="entity-cell">
                                            @(registro.EjecutoraNombre
                                                ?? "Todas las entidades")
                                        </td>

                                        <td>
                                            @registro.NivelGobiernoNombre
                                        </td>

                                        <td>
                                            @registro.DepartamentoEjecutoraNombre
                                        </td>

                                        <td>
                                            S/
                                            @registro.Pia2019.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Pim2019.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Devengado2019.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>

                                            @{
                                                var porcentaje2019 =
                                                    registro.Pim2019 > 0
                                                        ? (
                                                            registro.Devengado2019 /
                                                            registro.Pim2019
                                                        ) * 100
                                                        : 0m;
                                            }

                                            @porcentaje2019.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))%

                                        </td>

                                    </tr>


                                    <!-- ================================= -->
                                    <!-- 2020 -->
                                    <!-- ================================= -->

                                    <tr>

                                        <td>
                                            2020
                                        </td>

                                        <td class="entity-cell">
                                            @(registro.EjecutoraNombre
                                                ?? "Todas las entidades")
                                        </td>

                                        <td>
                                            @registro.NivelGobiernoNombre
                                        </td>

                                        <td>
                                            @registro.DepartamentoEjecutoraNombre
                                        </td>

                                        <td>
                                            S/
                                            @registro.Pia2020.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Pim2020.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>
                                            S/
                                            @registro.Devengado2020.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                        </td>

                                        <td>

                                            @{
                                                var porcentaje2020 =
                                                    registro.Pim2020 > 0
                                                        ? (
