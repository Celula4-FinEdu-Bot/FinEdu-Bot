</div>


@code {

    // ==========================================================
    // ESTADO
    // ==========================================================

    private string Pregunta =
        "muestrame el registro del año 2017-2021";
    

    private string SessionId =
    Guid.NewGuid().ToString("N");

    private NlqResponse? Resultado;

    private bool Cargando;
  
    private const int TamanioPagina = 10;

    private bool ConsultaRealizada;

    private int PaginaActual { get; set; } = 1;

    // Cantidad de registros MEF que se muestran por página.
    private const int RegistrosPorPagina = 10;

    private int TotalPaginas =>
        Resultado?.Evolucion is { Count: > 0 }
            ? (int)Math.Ceiling(
                Resultado.Evolucion.Count /
                (double)RegistrosPorPagina)
            : 0;

    private IEnumerable<EvolucionPresupuesto> RegistrosPagina
    {
        get
        {
            if (Resultado?.Evolucion == null)
                return Enumerable.Empty<EvolucionPresupuesto>();

            return Resultado.Evolucion
                .Skip((PaginaActual - 1) * RegistrosPorPagina)
                .Take(RegistrosPorPagina);
        }
    }


    // ==========================================================
    // CONSULTAR
    // ==========================================================

    private async Task ConsultarAsync()
    {
        if (string.IsNullOrWhiteSpace(Pregunta))
            return;

        Cargando = true;

        ConsultaRealizada = false;

        Resultado = null;

        // Cada nueva consulta comienza nuevamente
        // desde la primera página.
        PaginaActual = 1;

        try
        {
            Resultado = await NlqService.ProcesarAsync(
                        Pregunta.Trim(),
                        PaginaActual,
                        TamanioPagina,
                        SessionId,
                        CancellationToken.None);

            ConsultaRealizada = true;
        }
        finally
        {
            Cargando = false;
        }
    }

    //Paginación
    private async Task CambiarPagina(int pagina)
    {
        if (Cargando)
        {
            return;
        }

        if (Resultado == null)
        {
            return;
        }

        if (pagina < 1 ||
            pagina > Resultado.TotalPaginas)
        {
            return;
        }

        PaginaActual =
            pagina;

        Cargando = true;

        try
        {
            @* se agrego sessionId *@
            Resultado =
                await NlqService.ProcesarAsync(
                    Pregunta.Trim(),
                    PaginaActual,
                    TamanioPagina,                    
                    SessionId,
                    CancellationToken.None);
        }
        finally
        {
            Cargando = false;
        }
    }

    //metodos de paginación
    private void PaginaAnterior()
    {
        if (PaginaActual > 1)
        {
            PaginaActual--;
        }
    }

    private void PaginaSiguiente()
    {
        if (PaginaActual < TotalPaginas)
        {
            PaginaActual++;
        }
    }

    // =========================================================
    // CONSULTA
    // =========================================================


    // ==========================================================
    // ENTER
    // ==========================================================

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !Cargando)
        {
            await ConsultarAsync();
        }
    }


    // ==========================================================
    // USAR EJEMPLO
    // ==========================================================

    private async Task UsarEjemplo(string ejemplo)
    {
        Pregunta = ejemplo;

        await ConsultarAsync();
    }

    

}