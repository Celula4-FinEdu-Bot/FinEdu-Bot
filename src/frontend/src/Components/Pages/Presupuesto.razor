@page "/presupuesto"
@rendermode InteractiveServer
@using src.Models
@using src.Services
@inject MefResumenService MefResumenService

<PageTitle>Análisis Presupuestal MEF | FinEdu-Bot</PageTitle>

<div class="mef-encabezado">

    <div class="mef-encabezado-contenido">

        <span class="mef-etiqueta">
            FINEDU-BOT / MEF
        </span>

        <h2>Análisis de Ejecución Presupuestal</h2>

        <p>
            Consulta y analiza la información presupuestaria
            de las entidades públicas del Perú durante el
            periodo 2022–2025.
        </p>

    </div>

</div>

<!-- FILTROS DE CONSULTA MEF -->
<div class="card mb-4 mef-tarjeta-filtros">
    <div class="card-body">

        <h5 class="mb-3">Filtros de consulta</h5>

        <div class="row g-3">

            <!-- ENTIDAD -->
            <div class="col-md-8">
                <label class="form-label">Entidad pública</label>

                <div class="buscador-entidad">

                    <input type="text"
                        class="form-control"
                        placeholder="Buscar entidad pública..."
                        autocomplete="off"
                        @bind="entidadSeleccionada"
                        @bind:event="oninput"
                        @bind:after="AlEscribirEntidad" />

                    @if (mostrarSugerencias)
                    {
                        <div class="lista-sugerencias">

                            @foreach (var entidad in ObtenerSugerencias())
                            {
                                <button type="button"
                                        class="sugerencia-entidad"
                                        @onclick="() => SeleccionarEntidad(entidad)">
                                    @entidad
                                </button>
                            }

                        </div>
                    }

                </div>
            </div>

            <!-- AÑO -->
            <div class="col-md-4">
                <label class="form-label">
                    Año fiscal
                </label>

                <select class="form-select"
                        @bind="anioSeleccionado">

                    <option value="2022">2022</option>
                    <option value="2023">2023</option>
                    <option value="2024">2024</option>
                    <option value="2025">2025</option>

                </select>
            </div>

        </div>

        <div class="mt-3">
            <button type="button"
                    class="btn btn-primary mef-boton-consulta"
                    @onclick="PrepararConsulta">

                Consultar presupuesto

            </button>
        </div>

        @if (!string.IsNullOrEmpty(mensajeFiltros))
        {
            <div class="alert alert-info mt-3">
                @mensajeFiltros
            </div>
        }

    </div>
</div>

<!-- RESULTADOS PRESUPUESTARIOS MEF -->
<div class="card mb-4 mef-resumen">
    <div class="card-header">
        <h5 class="mb-0">Resumen Presupuestario</h5>
    </div>

    <div class="card-body">

        <p class="text-muted">
            Entidad: <strong>@entidadSeleccionada</strong>
            <br />
            Año fiscal: <strong>@anioSeleccionado</strong>
        </p>

        <div class="row g-3">

            <div class="col-md-3">
                <div class="card resumen-indicador resumen-pia h-100">
                    <div class="card-body text-center">
                        <h6>PIA</h6>
                        <h4>@(resumenMef is null ? "—" : $"S/ {resumenMef.Pia:N2}")</h4>
                        <small>Presupuesto inicial</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card resumen-indicador resumen-pim h-100">
                    <div class="card-body text-center">
                        <h6>PIM</h6>
                        <h4>@(resumenMef is null ? "—" : $"S/ {resumenMef.Pim:N2}")</h4>
                        <small>Presupuesto modificado</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card resumen-indicador resumen-devengado h-100">
                    <div class="card-body text-center">
                        <h6>Devengado</h6>
                        <h4>@(resumenMef is null ? "—" : $"S/ {resumenMef.Devengado:N2}")</h4>
                        <small>Gasto ejecutado</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card resumen-indicador resumen-ejecucion h-100">
                    <div class="card-body text-center">
                        <h6>% Ejecución</h6>
                        <h4>@(resumenMef?.PorcentajeEjecucion is decimal p ? $"{p:N2} %" : "—")</h4>
                        <small>Devengado / PIM</small>
                    </div>
                </div>
            </div>

        </div>

        @if (resumenMef is null)
        {
            <div class="alert alert-light border mt-3 mb-0">
                <strong>Sin resultados.</strong>
                Busca una entidad pública, selecciona un año fiscal
                y pulsa "Consultar presupuesto" para visualizar su presupuesto.
            </div>
        }

    </div>
</div>



@code {

    private string entidadSeleccionada = "M. DE EDUCACION";
    private int anioSeleccionado = 2025;
    private string? mensajeFiltros;

    private static string NormalizarNombre(string texto)
    {
        var caracteres = texto.Trim()
            .ToUpperInvariant()
            .Normalize(System.Text.NormalizationForm.FormD)
            .Where(c =>
                System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                != System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray();

        var nombre = new string(caracteres)
            .Replace(".", "")
            .Replace(",", "")
            .Replace("-", " ");

        return string.Join(
            " ",
            nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        );
    }

    private void PrepararConsulta()
    {
        mostrarSugerencias = false;
        resumenMef = null;

        if (string.IsNullOrWhiteSpace(entidadSeleccionada))
        {
            mensajeFiltros = "Por favor, escribe una entidad pública.";
            return;
        }

        // Interpretar nombres completos y abreviaturas
        var equivalencias = new Dictionary<string, string>
        {
            ["MINEDU"] = "M DE EDUCACION",
            ["MINISTERIO DE EDUCACION"] = "M DE EDUCACION",

            ["MINSA"] = "M DE SALUD",
            ["MINISTERIO DE SALUD"] = "M DE SALUD",

            ["MININTER"] = "M DEL INTERIOR",
            ["MINISTERIO DEL INTERIOR"] = "M DEL INTERIOR"
        };

        var nombreBuscado = NormalizarNombre(entidadSeleccionada);

        if (equivalencias.TryGetValue(nombreBuscado, out var nombreOficial))
        {
            nombreBuscado = nombreOficial;
        }

        // Buscar solamente en el año seleccionado
        var registrosDelAnio = registrosMef
            .Where(x => x.Anio == anioSeleccionado)
            .ToList();

        // Primero buscar coincidencias exactas
        var coincidencias = registrosDelAnio
            .Where(x =>
                NormalizarNombre(x.PliegoNombre) == nombreBuscado)
            .ToList();

        // Si no hay coincidencia exacta, buscar coincidencias parciales
        if (coincidencias.Count == 0)
        {
            coincidencias = registrosDelAnio
                .Where(x =>
                    NormalizarNombre(x.PliegoNombre)
                        .Contains(nombreBuscado))
                .ToList();
        }

        if (coincidencias.Count == 0)
        {
            mensajeFiltros =
                "No se encontró ninguna entidad con ese nombre.";
            return;
        }

        if (coincidencias.Count > 1)
        {
            var opciones = string.Join("; ",
                coincidencias.Take(5).Select(x =>
                    $"{x.Pliego} - {x.PliegoNombre}"));

            mensajeFiltros =
                $"Se encontraron {coincidencias.Count} coincidencias: " +
                $"{opciones}. Escribe el nombre completo de la entidad.";

            return;
        }

        resumenMef = coincidencias[0];

        // Mostrar el nombre oficial encontrado
        entidadSeleccionada = resumenMef.PliegoNombre;

        mensajeFiltros = null;
    }
    private List<ResumenMef> registrosMef = new();
    private ResumenMef? resumenMef;

    protected override void OnInitialized()
    {
        try
        {
            registrosMef = MefResumenService.ObtenerRegistros();
        }
        catch (Exception)
        {
            mensajeFiltros =
                "No se pudieron cargar los datos del MEF.";
        }
    }
    private bool mostrarSugerencias = false;

    private void AlEscribirEntidad()
    {
        mostrarSugerencias =
            entidadSeleccionada.Trim().Length >= 2;

        resumenMef = null;
        mensajeFiltros = null;
    }

    private void SeleccionarEntidad(string nombre)
    {
        entidadSeleccionada = nombre;
        mostrarSugerencias = false;

        resumenMef = null;
        mensajeFiltros = null;
    }

    private List<string> ObtenerSugerencias()
    {
        var busqueda = NormalizarNombre(entidadSeleccionada);

        if (busqueda.Length < 2)
            return new List<string>();

        var equivalencias = new Dictionary<string, string>
        {
            ["MINEDU"] = "M DE EDUCACION",
            ["MINSA"] = "M DE SALUD",
            ["MININTER"] = "M DEL INTERIOR"
        };

        if (equivalencias.TryGetValue(busqueda, out var oficial))
        {
            busqueda = oficial;
        }

        return registrosMef
            .Select(x => x.PliegoNombre)
            .Distinct()
            .Where(x =>
                NormalizarNombre(x).Contains(busqueda))
            .OrderBy(x => x)
            .Take(6)
            .ToList();
    }

}