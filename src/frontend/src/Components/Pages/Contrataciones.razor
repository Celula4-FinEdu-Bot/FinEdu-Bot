        border-radius: 9px;
    }

    .query-form {
        display: flex;
        gap: 10px;
    }

    .query-input {
        flex: 1;
        height: 52px;
        border: 1px solid #d6deeb;
        border-radius: 10px;
        padding: 0 16px;
        font-size: 15px;
        outline: none;
    }

    .query-button {
        height: 52px;
        border: none;
        border-radius: 10px;
        padding: 0 26px;
        background: #2563eb;
        color: white;
        font-weight: 700;
        cursor: pointer;
    }

    .query-button:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .filters-grid {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 15px;
        margin-top: 22px;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

