        color: #102a56;
    }

    .page-header {
        max-width: 1200px;
        margin: 0 auto 24px;
    }

    .eyebrow {
        color: #2563eb;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .page-header h1 {
        margin: 8px 0;
        font-size: 38px;
        font-weight: 700;
    }

    .subtitle {
        color: #52627a;
        font-size: 16px;
    }

    .query-card {
        max-width: 1200px;
        margin: 0 auto;
        background: white;
        border: 1px solid #dce3ee;
        border-radius: 20px;
        padding: 30px;
