@page "/contrataciones"
@rendermode InteractiveServer

@using src.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization

@inject OeceService OeceService

<PageTitle>Contrataciones | FinEdu-Bot</PageTitle>


<div class="page-container">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <div class="page-header">

        <span class="eyebrow">
            MICROFRONTEND OECE
        </span>

        <h1>
            Explorador de contrataciones
        </h1>

        <p class="subtitle">
            Consulta información del Plan Anual de Contrataciones
            mediante el dataset local OECE 2018.
        </p>

    </div>


    <!-- ===================================================== -->
    <!-- TARJETA PRINCIPAL -->
    <!-- ===================================================== -->

    <section class="query-card">

        <div class="query-header">

            <div>

                <span class="section-label">
                    OECE / PAC 2018
                </span>

                <h2>
                    ¿Qué deseas consultar?
                </h2>

            </div>

            <div class="source-badge">
                OECE
            </div>

        </div>


        <!-- ================================================= -->
        <!-- CONSULTA LIBRE -->
        <!-- ================================================= -->

        <div class="query-form">

            <input
                class="query-input"
                type="text"
                @bind="Texto"
                @bind:event="oninput"
                @onkeydown="HandleKeyDown"
                placeholder="Ej. Municipalidad Distrital de Chambara"
                disabled="@Cargando" />


            <button
                type="button"
                class="query-button"
                @onclick="BuscarAsync"
                disabled="@Cargando">

                @if (Cargando)
                {
                    <span class="spinner"></span>

                    <span>
                        Consultando...
                    </span>
                }
                else
                {
                    <span>
                        Consultar
                    </span>
                }

            </button>

        </div>


        <!-- ================================================= -->
        <!-- FILTROS -->
        <!-- ================================================= -->

        <div class="filters-grid">

            <!-- AÑO -->

            <div class="filter-field">

                <label>
                    Año
                </label>

                <select @bind="Anio">

                    <option value="">
                        Todos
                    </option>

                    <option value="2018">
                        2018
                    </option>

                </select>

            </div>


            <!-- DEPARTAMENTO -->

            <div class="filter-field">

                <label>
                    Departamento
                </label>

                <input
                    type="text"
                    @bind="Departamento"
                    placeholder="Ej. LIMA" />

            </div>


            <!-- ENTIDAD -->

            <div class="filter-field">

                <label>
                    Entidad
                </label>

                <input
                    type="text"
                    @bind="Entidad"
                    placeholder="Ej. SUNAT" />

            </div>


            <!-- TIPO DE PROCESO -->

            <div class="filter-field">

                <label>
                    Tipo de proceso
                </label>

                <input
                    type="text"
                    @bind="TipoProceso"
                    placeholder="Ej. Adjudicación Simplificada" />

            </div>


            <!-- OBJETO -->

            <div class="filter-field">

                <label>
                    Objeto contractual
                </label>

                <input
                    type="text"
                    @bind="ObjetoContractual"
                    placeholder="Ej. Bien" />

            </div>


            <!-- MES -->

            <div class="filter-field">

                <label>
                    Mes previsto
                </label>

                <select @bind="Mes">

                    <option value="">
                        Todos
                    </option>

                    @for (
                        var mes = 1;
                        mes <= 12;
                        mes++)
                    {
                        <option value="@mes">
                            @GetMonthName(mes)
                        </option>
                    }

                </select>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- EJEMPLOS -->
        <!-- ================================================= -->

        <div class="examples">

            <span class="examples-title">
                Ejemplos:
            </span>


            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("Municipalidad Distrital de Chambara")'>

                Municipalidad de Chambara

            </button>


            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("Fuerza Aerea del Peru")'>

                Fuerza Aérea del Perú

            </button>


            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("Gobierno Regional de Cusco")'>

                Gobierno Regional de Cusco

            </button>


            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("SUNAT")'>

                SUNAT

            </button>


            <button
                type="button"
                class="example-button"
                @onclick='() => UsarEjemplo("Subasta Inversa Electrónica")'>

                Subasta Inversa

            </button>

        </div>


        <!-- ================================================= -->
        <!-- MENSAJE -->
        <!-- ================================================= -->

        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="info-message">

                @Mensaje

            </div>
        }


        <!-- ================================================= -->
        <!-- ERROR -->
        <!-- ================================================= -->

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error-message">

                <strong>
                    Error
                </strong>

                <div>
                    @Error
                </div>

            </div>
        }


        <!-- ================================================= -->
        <!-- RESUMEN -->
        <!-- ================================================= -->

        @if (
            Resultado != null &&
            Resultado.Success)
        {
            <div class="summary-grid">

                <div class="summary-card">

                    <span class="summary-label">
                        COINCIDENCIAS
                    </span>

                    <strong class="summary-value">
                        @Resultado.Total
                    </strong>

                </div>


                <div class="summary-card">

                    <span class="summary-label">
                        MOSTRADOS
                    </span>

                    <strong class="summary-value">
                        @Resultado.Records.Count
                    </strong>

                </div>


                <div class="summary-card">

                    <span class="summary-label">
                        FUENTE
                    </span>

                    <strong class="summary-source">
                        OECE / PAC 2018
                    </strong>

                </div>

            </div>
        }


        <!-- ================================================= -->
        <!-- RESULTADOS -->
        <!-- ================================================= -->

        @if (
            Resultado != null &&
            Resultado.Success &&
            Resultado.Records.Count > 0)
        {
            <div class="results-container">

                <div class="results-header">

                    <div>

                        <span class="section-label">
                            RESULTADOS OECE
                        </span>

                        <h3>
                            Procesos de contratación
                        </h3>

                    </div>

                </div>


                <div class="table-wrapper">

                    <table class="results-table">

                        <thead>

                            <tr>

                                <th>
                                    AÑO
                                </th>

                                <th>
                                    ENTIDAD
                                </th>

                                <th>
                                    RUC
                                </th>

                                <th>
                                    N. REFERENCIA
                                </th>

                                <th>
                                    DESCRIPCIÓN DEL PROCESO
                                </th>

                                <th>
                                    TIPO DE PROCESO
                                </th>

                                <th>
                                    OBJETO
                                </th>

                                <th>
                                    ITEM
                                </th>

                                <th>
                                    DESCRIPCIÓN DEL ITEM
                                </th>

                                <th>
                                    CANTIDAD
                                </th>

                                <th>
                                    UNIDAD
                                </th>

                                <th>
                                    DEPARTAMENTO
                                </th>

                                <th>
                                    PROVINCIA
                                </th>

                                <th>
                                    DISTRITO
                                </th>

                                <th>
                                    MES PREVISTO
                                </th>

                                <th>
                                    FECHA PUBLICACIÓN
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (
                                var registro
                                in Resultado.Records)
                            {
                                <tr>

                                    <td>
                                        @registro.Anio
                                    </td>


                                    <td class="entity-cell">

                                        @(
                                            registro.Entidad
                                            ?? "-"
                                        )

                                    </td>


                                    <td>
                                        @(
                                            registro.RucEntidad
                                            ?? "-"
                                        )
                                    </td>


                                    <td>
                                        @(
                                            registro.NumeroReferencia
                                            ?? "-"
                                        )
                                    </td>


                                    <td class="description-cell">

                                        @(
                                            registro.DescripcionProceso
                                            ?? "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.TipoProcesoSeleccion
                                            ?? "-"
                                        )

                                    </td>


                                    <td>
                                        @(
                                            registro.ObjetoContractual
                                            ?? "-"
                                        )
                                    </td>


                                    <td>
                                        @(
                                            registro.NumeroItem
                                            ?? "-"
                                        )
                                    </td>


                                    <td class="description-cell">

                                        @(
                                            registro.DescripcionItem
                                            ?? "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.Cantidad?.ToString(
                                                "N2",
                                                CultureInfo.GetCultureInfo(
                                                    "es-PE"))
                                            ?? "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.UnidadMedida
                                            ?? "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.Departamento
                                            ?? "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.Provincia
                                            ?? "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.Distrito
                                            ?? "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.MesPrevisto.HasValue
                                                ? GetMonthName(
                                                    registro.MesPrevisto.Value)
                                                : "-"
                                        )

                                    </td>


                                    <td>

                                        @(
                                            registro.FechaPublicacion
                                            ?? "-"
                                        )

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else if (
            Resultado != null &&
            Resultado.Success &&
            Resultado.Records.Count == 0)
        {
            <div class="no-results">

                <div class="no-results-icon">
                    !
                </div>

                <div>

                    <h3>
                        No se encontraron procesos
                    </h3>

                    <p>
                        No existen coincidencias con los filtros seleccionados.
                    </p>

                </div>

            </div>
        }

    </section>

</div>


<style>

