        animation: spin .8s linear infinite;
        margin-right: 7px;
    }

    @@keyframes spin {

        to {
            transform: rotate(360deg);
        }

    }

    @@media (max-width: 800px) {

        .query-form {
            flex-direction: column;
        }

        .query-button {
            width: 100%;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

    }

</style>


@code {

    private string Texto = "";

    private string Anio = "";

    private string Departamento = "";

    private string Entidad = "";

    private string TipoProceso = "";

    private string ObjetoContractual = "";

    private string Mes = "";

    private bool Cargando;

    private string Mensaje = "";

    private string Error = "";

    private OeceSearchResult? Resultado;


    // ============================================================
    // BUSCAR
    // ============================================================

    private async Task BuscarAsync()
    {
        if (Cargando)
        {
            return;
        }

        Cargando = true;

        Mensaje = "";

        Error = "";

        Resultado = null;

        try
        {
            int? anio =
                int.TryParse(
                    Anio,
                    out var anioValue)
                    ? anioValue
                    : null;


            int? mes =
                int.TryParse(
                    Mes,
                    out var mesValue)
                    ? mesValue
                    : null;


            Resultado =
                await OeceService.BuscarAsync(
                    texto: Texto,
                    anio: anio,
                    departamento: Departamento,
                    entidad: Entidad,
                    tipoProceso: TipoProceso,
                    objetoContractual: ObjetoContractual,
                    mes: mes,
                    limite: 100,
                    cancellationToken:
                        CancellationToken.None);


            if (Resultado.Success)
            {
                Mensaje =
                    Resultado.Message;
            }
            else
            {
                Error =
                    Resultado.Message;
            }
        }
        catch (Exception ex)
        {
            Error =
                $"No fue posible consultar el Excel OECE: {ex.Message}";
        }
        finally
        {
            Cargando = false;
        }
    }


    // ============================================================
    // ENTER
    // ============================================================

    private async Task HandleKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarAsync();
        }
    }


    // ============================================================
    // EJEMPLO
    // ============================================================

    private async Task UsarEjemplo(
        string texto)
    {
        Texto = texto;

        await BuscarAsync();
    }


    // ============================================================
    // MES
    // ============================================================

    private static string GetMonthName(
        int month)
    {
        return CultureInfo
            .GetCultureInfo("es-PE")
            .DateTimeFormat
            .GetMonthName(month);
    }

}