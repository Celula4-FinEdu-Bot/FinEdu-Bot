        font-size: 12px;
        font-weight: 700;
        color: #475569;
    }

    .filter-field input,
    .filter-field select {
        height: 42px;
        border: 1px solid #d6deeb;
        border-radius: 8px;
        padding: 0 10px;
        background: white;
    }

    .examples {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
    }

    .examples-title {
        color: #64748b;
