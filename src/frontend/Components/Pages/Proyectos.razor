@page "/proyectos"

@using System.Net.Http.Json
@using FinEduBot.Frontend.Models

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Proyectos | FinEdu-Bot</PageTitle>

<div class="page-header">

    <div>
        <span class="eyebrow">
            HU-12
        </span>

        <h1>
            Proyectos y categorías
        </h1>

        <p>
            Identificación de las categorías y proyectos
            con mayor presupuesto y ejecución.
        </p>
    </div>

    <div class="year-selector">

        <label>
            Año
        </label>

        <input
            type="number"
            min="2000"
            max="2100"
            @bind="year" />

        <button
            class="primary-button"
            @onclick="LoadDataAsync"
            disabled="@loading">
            @(loading ? "Cargando..." : "Actualizar")
        </button>

    </div>

</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="error-message">
        @error
    </div>
}

@if (loading)
{
    <div class="loading-card">
        Consultando información del MEF...
    </div>
}
else if (data.Count == 0)
{
    <div class="empty-card">
        No se encontraron proyectos.
    </div>
}
else
{
    <section class="metrics-grid">

        <div class="metric-card">
            <span>
                Registros
            </span>

            <strong>
                @data.Count
            </strong>
        </div>

        <div class="metric-card">
            <span>
                Presupuesto total
            </span>

            <strong>
                @FormatCurrency(
                    data.Sum(x => x.Presupuesto))
            </strong>
        </div>

        <div class="metric-card">
            <span>
                Ejecución total
            </span>

            <strong>
                @FormatCurrency(
                    data.Sum(x => x.Ejecutado))
            </strong>
        </div>

    </section>

    <section class="data-card">

        <div class="data-card-header">

            <div>
                <span class="section-label">
                    DATA INTERACTION
                </span>

                <h2>
                    Mayor ejecución
                </h2>
            </div>

        </div>

        <div class="table-container">

            <table>

                <thead>

                    <tr>
                        <th>
                            Categoría
                        </th>

                        <th>
                            Proyecto
                        </th>

                        <th>
                            Presupuesto
                        </th>

                        <th>
                            Ejecutado
                        </th>

                        <th>
                            %
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in data)
                    {
                        <tr>

                            <td>
                                @item.Categoria
                            </td>

                            <td>
                                @item.Proyecto
                            </td>

                            <td>
                                @FormatCurrency(
                                    item.Presupuesto)
                            </td>

                            <td>
                                @FormatCurrency(
                                    item.Ejecutado)
                            </td>

                            <td>
                                <span class="status-pill">
                                    @item.PorcentajeEjecucion.ToString("N2")%
                                </span>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>
}

@code {

    private int year = DateTime.Now.Year;

    private bool loading;

    private string error = string.Empty;

    private List<ProyectoPresupuestoDto> data = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        error = string.Empty;

        try
        {
            var client =
                HttpClientFactory.CreateClient();

            var response =
                await client.GetFromJsonAsync<
                    List<ProyectoPresupuestoDto>>(
                        $"/api/mef/proyectos?anio={year}");

            data = response ?? [];
        }
        catch (Exception ex)
        {
            error =
                $"No fue posible obtener los proyectos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatCurrency(
        decimal value)
    {
        return value.ToString(
            "C0",
            new System.Globalization.CultureInfo("es-PE"));
    }
}