@page "/contrataciones"

<PageTitle>Contrataciones | FinEdu-Bot</PageTitle>

<div class="page-header">

    <div>

        <span class="eyebrow">
            MICROFRONTEND OECE
        </span>

        <h1>
            Contrataciones adjudicadas
        </h1>

        <p>
            Consulta de contrataciones públicas,
            descargas masivas y registros por OCID.
        </p>

    </div>

</div>

<section class="oece-microfrontend">

    <div class="oece-header">

        <div>

            <span class="oece-label">
                OECE
            </span>

            <h2>
                Explorador de contrataciones
            </h2>

        </div>

        <span class="connection-status">
            Fuente externa
        </span>

    </div>

    <div class="oece-search">

        <div class="search-field">

            <label>
                Año
            </label>

            <select @bind="year">

                @for (var currentYear = 2026;
                      currentYear >= 2020;
                      currentYear--)
                {
                    <option value="@currentYear">
                        @currentYear
                    </option>
                }

            </select>

        </div>

        <div class="search-field">

            <label>
                Mes
            </label>

            <select @bind="month">

                @for (var currentMonth = 1;
                      currentMonth <= 12;
                      currentMonth++)
                {
                    <option value="@currentMonth">
                        @GetMonthName(currentMonth)
                    </option>
                }

            </select>

        </div>

        <div class="search-field ocid-field">

            <label>
                OCID
            </label>

            <input
                @bind="ocid"
                placeholder="ocds-dgv273-seacev2-3496677" />

        </div>

        <button
            class="primary-button"
            @onclick="Search">
            Buscar
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="info-message">
            @message
        </div>
    }

    <div class="oece-grid">

        <div class="oece-card">

            <div class="oece-card-icon">
                ↓
            </div>

            <h3>
                Descarga masiva
            </h3>

            <p>
                Preparado para consultar el archivo
                de descarga masiva correspondiente
                al año y mes seleccionado.
            </p>

            <button
                class="secondary-button"
                @onclick="DownloadMassive">
                Obtener descarga
            </button>

        </div>

        <div class="oece-card">

            <div class="oece-card-icon">
                ≡
            </div>

            <h3>
                Archivos por período
            </h3>

            <p>
                Permite mostrar los archivos de
                contrataciones agrupados por año y mes.
            </p>

            <button
                class="secondary-button"
                @onclick="ListFiles">
                Ver archivos
            </button>

        </div>

        <div class="oece-card">

            <div class="oece-card-icon">
                #
            </div>

            <h3>
                Consulta por OCID
            </h3>

            <p>
                Consulta individual de un proceso de
                contratación mediante su identificador OCID.
            </p>

            <button
                class="secondary-button"
                @onclick="SearchOcid">
                Consultar OCID
            </button>

        </div>

    </div>

    <div class="oece-preview">

        <div class="preview-header">

            <div>

                <span class="section-label">
                    DATA INTERACTION
                </span>

                <h2>
                    Resultado
                </h2>

            </div>

            <span class="preview-source">
                OECE API
            </span>

        </div>

        @if (string.IsNullOrWhiteSpace(ocid))
        {
            <div class="empty-preview">

                <strong>
                    Sin consulta
                </strong>

                <p>
                    Ingresa un OCID o selecciona
                    un período para iniciar.
                </p>

            </div>
        }
        else
        {
            <div class="ocid-result">

                <span>
                    OCID consultado
                </span>

                <strong>
                    @ocid
                </strong>

                <small>
                    La integración con la API OECE
                    será conectada en la siguiente etapa.
                </small>

            </div>
        }

    </div>

</section>

@code {

    private int year = 2026;

    private int month = DateTime.Now.Month;

    private string ocid = string.Empty;

    private string message = string.Empty;

    private void Search()
    {
        message =
            $"Consulta preparada para {GetMonthName(month)} de {year}.";
    }

    private void DownloadMassive()
    {
        message =
            $"La descarga masiva para {GetMonthName(month)} de {year} " +
            "queda preparada para conectarse al endpoint OECE.";
    }

    private void ListFiles()
    {
        message =
            $"Se solicitará el listado de archivos agrupados " +
            $"para {year}.";
    }

    private void SearchOcid()
    {
        if (string.IsNullOrWhiteSpace(ocid))
        {
            message =
                "Ingresa un OCID para realizar la consulta.";

            return;
        }

        message =
            $"OCID preparado para consulta: {ocid}";
    }

    private static string GetMonthName(
        int month)
    {
        return new System.Globalization.CultureInfo("es-PE")
            .DateTimeFormat
            .GetMonthName(month);
    }
}