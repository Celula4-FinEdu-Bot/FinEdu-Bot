        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"success\": {\n      \"type\": \"boolean\"\n    },\n    \"intent\": {\n      \"type\": \"string\"\n    },\n    \"message\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"risk\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"SAFE\",\n        \"HIGH_RISK\"\n      ]\n    },\n    \"evolucion\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"entidad\": {\n            \"type\": \"string\"\n          },\n          \"departamento\": {\n            \"type\": \"string\"\n          },\n          \"provincia\": {\n            \"type\": \"string\"\n          },\n          \"distrito\": {\n            \"type\": \"string\"\n          },\n          \"anio\": {\n            \"type\": \"integer\"\n          },\n          \"pia\": {\n            \"type\": \"number\"\n          },\n          \"pim\": {\n            \"type\": \"number\"\n          },\n          \"certificado\": {\n            \"type\": \"number\"\n          },\n          \"comprometido_anual\": {\n            \"type\": \"number\"\n          },\n          \"comprometido\": {\n            \"type\": \"number\"\n          },\n          \"devengado\": {\n            \"type\": \"number\"\n          },\n          \"girado\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"entidad\",\n          \"departamento\",\n          \"provincia\",\n          \"distrito\",\n          \"anio\",\n          \"pia\",\n          \"pim\",\n          \"certificado\",\n          \"comprometido_anual\",\n          \"comprometido\",\n          \"devengado\",\n          \"girado\"\n        ]\n      }\n    },\n    \"presupuestos\": {\n      \"type\": \"array\"\n    },\n    \"proyectos\": {\n      \"type\": \"array\"\n    },\n    \"contrataciones\": {\n      \"type\": \"array\"\n    },\n    \"totalRegistros\": {\n      \"type\": \"integer\"\n    },\n    \"paginaActual\": {\n      \"type\": \"integer\"\n    },\n    \"tamanioPagina\": {\n      \"type\": \"integer\"\n    },\n    \"totalPaginas\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": [\n    \"success\",\n    \"intent\",\n    \"message\",\n    \"output\",\n    \"risk\",\n    \"evolucion\",\n    \"presupuestos\",\n    \"proyectos\",\n    \"contrataciones\",\n    \"totalRegistros\",\n    \"paginaActual\",\n    \"tamanioPagina\",\n    \"totalPaginas\"\n  ]\n}",
        "autoFix": true
