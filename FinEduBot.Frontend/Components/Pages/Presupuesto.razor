@page "/presupuesto"

@using System.Net.Http.Json
@using FinEduBot.Frontend.Models

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Presupuesto | FinEdu-Bot</PageTitle>

<div class="page-header">

    <div>
        <span class="eyebrow">
            HU-11
        </span>

        <h1>
            Evolución mensual del presupuesto
        </h1>

        <p>
            Visualización de presupuesto y ejecución
            a partir de los datos abiertos del MEF.
        </p>
    </div>

    <div class="year-selector">
        <label>
            Año
        </label>

        <input
            type="number"
            min="2000"
            max="2100"
            @bind="year" />

        <button
            class="primary-button"
            @onclick="LoadDataAsync"
            disabled="@loading">
            @(loading ? "Cargando..." : "Actualizar")
        </button>
    </div>

</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="error-message">
        @error
    </div>
}

@if (loading)
{
    <div class="loading-card">
        Consultando información del MEF...
    </div>
}
else if (data.Count == 0)
{
    <div class="empty-card">
        No se encontraron registros para el año seleccionado.
    </div>
}
else
{
    <section class="metrics-grid">

        <div class="metric-card">
            <span>
                Presupuesto
            </span>

            <strong>
                @FormatCurrency(
                    data.Sum(x => x.Presupuesto))
            </strong>
        </div>

        <div class="metric-card">
            <span>
                Ejecutado
            </span>

            <strong>
                @FormatCurrency(
                    data.Sum(x => x.Ejecutado))
            </strong>
        </div>

        <div class="metric-card">
            <span>
                Ejecución
            </span>

            <strong>
                @GetExecutionPercentage().ToString("N2")%
            </strong>
        </div>

    </section>

    <section class="data-card">

        <div class="data-card-header">
            <div>
                <span class="section-label">
                    DATA INTERACTION
                </span>

                <h2>
                    Evolución mensual
                </h2>
            </div>
        </div>

        <div class="chart-container">

            @foreach (var item in data)
            {
                var percentage =
                    item.Presupuesto <= 0
                        ? 0
                        : Math.Min(
                            100,
                            item.Ejecutado /
                            item.Presupuesto *
                            100);

                <div class="chart-column">

                    <div class="chart-values">
                        <span>
                            @FormatCurrency(item.Ejecutado)
                        </span>
                    </div>

                    <div class="chart-bar-wrapper">

                        <div
                            class="chart-bar"
                            style="@($"height:{percentage}%")">
                        </div>

                    </div>

                    <strong>
                        @item.NombreMes
                    </strong>

                    <small>
                        @percentage.ToString("N1")%
                    </small>

                </div>
            }

        </div>

    </section>

    <section class="data-card">

        <h2>
            Detalle mensual
        </h2>

        <div class="table-container">

            <table>

                <thead>
                    <tr>
                        <th>
                            Mes
                        </th>

                        <th>
                            Presupuesto
                        </th>

                        <th>
                            Ejecutado
                        </th>

                        <th>
                            Ejecución
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in data)
                    {
                        <tr>
                            <td>
                                @item.NombreMes
                            </td>

                            <td>
                                @FormatCurrency(
                                    item.Presupuesto)
                            </td>

                            <td>
                                @FormatCurrency(
                                    item.Ejecutado)
                            </td>

                            <td>
                                <span class="status-pill">
                                    @item.PorcentajeEjecucion.ToString("N2")%
                                </span>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>
}

@code {

    private int year = DateTime.Now.Year;

    private bool loading;

    private string error = string.Empty;

    private List<PresupuestoMensualDto> data = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        error = string.Empty;

        try
        {
            var client =
                HttpClientFactory.CreateClient();

            var response =
                await client.GetFromJsonAsync<
                    List<PresupuestoMensualDto>>(
                        $"/api/mef/presupuesto-mensual?anio={year}");

            data = response ?? [];
        }
        catch (Exception ex)
        {
            error =
                $"No fue posible obtener los datos del MEF: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private decimal GetExecutionPercentage()
    {
        var budget =
            data.Sum(x => x.Presupuesto);

        var executed =
            data.Sum(x => x.Ejecutado);

        if (budget <= 0)
        {
            return 0;
        }

        return executed / budget * 100;
    }

    private static string FormatCurrency(
        decimal value)
    {
        return value.ToString(
            "C0",
            new System.Globalization.CultureInfo("es-PE"));
    }
}