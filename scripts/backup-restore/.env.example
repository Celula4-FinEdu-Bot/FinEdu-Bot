# Copiar a la raíz del repositorio como .env y completar.
# Debe apuntar a la base PostgreSQL que se desea respaldar/restaurar.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/finedu_bot

# Nombre REAL del volumen Docker persistente de n8n.
# Consultar con: docker volume ls
N8N_VOLUME=finedu-bot_n8n_data

# Nombre del contenedor definido en infrastructure/docker-compose.yml
N8N_CONTAINER=n8n_local

# Carpeta local donde se crearán los respaldos.
BACKUP_ROOT=./backups
