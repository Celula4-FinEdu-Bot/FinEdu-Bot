# Copiar a ".env" y ajustar (NO subir .env a GitHub)
PROJECT_NAME=mi_proyecto

# Contenedores Docker (ver con: docker ps --format '{{.Names}}')
POSTGRES_CONTAINER=postgres
N8N_CONTAINER=n8n

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_DB=n8n

# n8n
N8N_HEALTH_URL=http://localhost:5678/healthz

# Carpeta donde se guardan los backups
BACKUP_DIR=./backups

# Dias que se conservan los backups (0 = no borrar)
RETENTION_DAYS=7

# Si se define, el backup se cifra con AES-256 (recomendado, contiene credenciales)
BACKUP_PASSPHRASE=
