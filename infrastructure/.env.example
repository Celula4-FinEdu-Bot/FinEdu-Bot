# Copia este archivo como .env en esta misma carpeta y completa los valores. El .env NO se sube a Git.
NODE_ENV=development
PORT=3000
API_PREFIX=/api
DATABASE_URL=postgresql://usuario:clave@localhost:5432/finedu_bot
N8N_WEBHOOK_URL=https://<tu-n8n>/webhook/ai-agent-orchestrator
N8N_WEBHOOK_AUTH_HEADER=X-Api-Key
N8N_WEBHOOK_AUTH_SECRET=<generar-con-openssl-rand-hex-32>
# Opcional (lo configura quien trabaja OECE):
# N8N_OECE_WEBHOOK_URL=https://<tu-n8n>/webhook/oece-sql
# Opcional, ya tienen valor por defecto en env.ts:
# MEF_API_BASE_URL=
# MEF_RESOURCE_ID=
