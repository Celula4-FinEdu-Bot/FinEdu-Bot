# FinEdu-Bot Environment Variables
# Copia este archivo a .env y completa los valores

# Entorno
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Base de datos PostgreSQL
DB_HOST=dpg-dahpo6ss728c73d2jhpg-a.oregon-postgres.render.com
DB_PORT=5432
DB_NAME=caso5_db
DB_USER=finedu_db
DB_PASSWORD=your_secure_password_here

# URL de la base de datos (alternativa a variables individuales)
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# n8n Webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-agent-orchestrator

# MEF API
MEF_API_BASE_URL=https://api.datosabiertos.mef.gob.pe/DatosAbiertos/v1/
MEF_RESOURCE_ID=5f3b3cbe-3955-41cc-8662-1757ebb5cf53

# Google Gemini API (para n8n)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Slack (para alertas de seguridad en n8n - opcional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Groq API (fallback opcional en n8n)
GROQ_API_KEY=your_groq_api_key_here